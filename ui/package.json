{
  "name": "@bboxsys/ui",
  "version": "0.20.1",
  "private": false,
  "type": "module",
  "description": "Shared Vue UI kit for apps built on the bboxsys platform: theme stylesheet and theme helpers, session store and login card for the platform admin server, admin API types, http client, data and object tables with the standard toolbar, metric tiles, accent surfaces, page notices, dialogs, map, API explorer, the AI assistant conversation and drawer, the documentation gate and Starlight site configuration, and shadcn-vue primitives. Shipped as source; the consuming Vite app compiles it.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bboxsys/platform.git",
    "directory": "ui"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./vite": {
      "types": "./src/vite/devProxy.d.mts",
      "default": "./src/vite/devProxy.mjs"
    },
    "./starlight": {
      "types": "./src/starlight/config.d.mts",
      "default": "./src/starlight/config.mjs"
    },
    "./starlight.css": "./src/starlight/theme.css",
    "./theme.css": "./src/theme/theme.css",
    "./brands/blue.css": "./src/theme/brands/blue.css",
    "./brands/orange.css": "./src/theme/brands/orange.css",
    "./src/*": "./src/*"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@lucide/vue": "^1.37.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "echarts": "^6.1.0",
    "happy-dom": "^20.0.0",
    "leaflet": "^1.9.4",
    "marked": "^18.1.1",
    "pinia": "^4.0.3",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.6.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.18",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.30",
    "@lucide/vue": ">=1",
    "@vueuse/core": ">=13",
    "class-variance-authority": ">=0.7",
    "clsx": ">=2",
    "dompurify": ">=3",
    "echarts": ">=5",
    "leaflet": ">=1.9",
    "marked": ">=12",
    "pinia": ">=3",
    "reka-ui": ">=2",
    "tailwind-merge": ">=3",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight": {
      "optional": true
    },
    "leaflet": {
      "optional": true
    }
  }
}
